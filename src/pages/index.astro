---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import B2BCTA from '../components/B2BCTA.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import { config } from '../config';

const title = 'Same-Day Courier Service in Nanaimo';
const description = `Reliable same-day courier and delivery service in Nanaimo, BC. Rush delivery, legal documents, medical specimens, and local routes. Get an instant quote online.`;
---

<BaseLayout {title} {description}>
  <SchemaMarkup type="LocalBusiness" />

  <!-- Hero Section - Minimalist, clean -->
  <section class="bg-white section-container">
    <div class="max-w-4xl">
      <div class="mb-12">
        <span class="badge bg-blue-100 text-blue-900">Nanaimo's Fastest Courier</span>
      </div>
      <h1 class="mb-6">Same-Day Delivery Across Vancouver Island</h1>
      <p class="text-xl text-neutral-700 mb-8 max-w-2xl">
        Fast, reliable courier service for legal documents, medical specimens, rush shipments, and regular routes. Pickup in 30 minutes. On-time guaranteed.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-16">
        <PhoneCTA text="Get Instant Quote" />
        <a href="/contact" class="cta-button-outline inline-block">Contact Us</a>
      </div>
    </div>

    <!-- Metrics Grid - Data-driven, prominent -->
    <div class="stats-grid">
      <div class="metric-card">
        <div class="metric-value">30</div>
        <div class="metric-label">Minutes to pickup</div>
        <p class="text-xs text-neutral-600 mt-2">During business hours</p>
      </div>
      <div class="metric-card">
        <div class="metric-value">100%</div>
        <div class="metric-label">On-time delivery</div>
        <p class="text-xs text-neutral-600 mt-2">Guaranteed reliability</p>
      </div>
      <div class="metric-card">
        <div class="metric-value">24/7</div>
        <div class="metric-label">Emergency service</div>
        <p class="text-xs text-neutral-600 mt-2">After-hours rush jobs</p>
      </div>
      <div class="metric-card">
        <div class="metric-value">4</div>
        <div class="metric-label">Island coverage</div>
        <p class="text-xs text-neutral-600 mt-2">Ferry routes included</p>
      </div>
    </div>
  </section>

  <!-- Services Overview - Clean, organized grid -->
  <section class="bg-neutral-50 section-container">
    <div class="mb-12">
      <h2>Core Services</h2>
      <p class="text-lg text-neutral-600 max-w-2xl">Choose the service that fits your need. From local same-day delivery to specialized medical transport.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <a href="/services/same-day-delivery" class="card group cursor-pointer">
        <div class="text-3xl mb-3">📦</div>
        <h3 class="group-hover:text-brand-blue transition-colors">Same-Day Delivery</h3>
        <p class="text-neutral-600 mb-4">
          Local Nanaimo within 3 hours. 3 PM cutoff weekdays, 10 AM weekends.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/rush-delivery" class="card group cursor-pointer">
        <div class="text-3xl mb-3">⚡</div>
        <h3 class="group-hover:text-brand-blue transition-colors">Rush & Hot-Shot</h3>
        <p class="text-neutral-600 mb-4">
          Emergency courier. Priority dispatch, dedicated driver if needed.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/medical-courier" class="card group cursor-pointer">
        <div class="text-3xl mb-3">🏥</div>
        <h3 class="group-hover:text-brand-blue transition-colors">Medical & Lab</h3>
        <p class="text-neutral-600 mb-4">
          Specimen transport. Temperature-controlled, chain-of-custody available.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/legal-courier" class="card group cursor-pointer">
        <div class="text-3xl mb-3">⚖️</div>
        <h3 class="group-hover:text-brand-blue transition-colors">Legal Courier</h3>
        <p class="text-neutral-600 mb-4">
          Court filings, legal documents. Certified drivers, proof of delivery.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/scheduled-delivery" class="card group cursor-pointer">
        <div class="text-3xl mb-3">📅</div>
        <h3 class="group-hover:text-brand-blue transition-colors">Scheduled Routes</h3>
        <p class="text-neutral-600 mb-4">
          Daily or weekly routes. Flat rates, recurring credit, dedicated dispatch.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/walmart-pickup" class="card group cursor-pointer">
        <div class="text-3xl mb-3">🛒</div>
        <h3 class="group-hover:text-brand-blue transition-colors">Walmart Pickup</h3>
        <p class="text-neutral-600 mb-4">
          Order online, we pick up and deliver. Same-day service to your door.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/grocery-pickup" class="card group cursor-pointer">
        <div class="text-3xl mb-3">🛍️</div>
        <h3 class="group-hover:text-brand-blue transition-colors">Grocery Delivery</h3>
        <p class="text-neutral-600 mb-4">
          Fresh groceries from Save-On, Thrifty Foods. Temperature-controlled delivery.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/ikea-delivery" class="card group cursor-pointer">
        <div class="text-3xl mb-3">🪑</div>
        <h3 class="group-hover:text-brand-blue transition-colors">IKEA Delivery</h3>
        <p class="text-neutral-600 mb-4">
          IKEA furniture delivery and assembly. Same-day pickup and installation.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/routes/nanaimo-victoria" class="card group cursor-pointer">
        <div class="text-3xl mb-3">🚢</div>
        <h3 class="group-hover:text-brand-blue transition-colors">Island Routes</h3>
        <p class="text-neutral-600 mb-4">
          Victoria, Comox, Port Alberni, Parksville. Ferry routing included.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">View Routes →</span>
      </a>
    </div>
  </section>

  <!-- B2B Focus - Structured, data-driven -->
  <section class="section-container">
    <div class="mb-12">
      <h2>Built for Business</h2>
      <p class="text-lg text-neutral-600 max-w-2xl">Specialized solutions for the industries that depend on reliability.</p>
    </div>

    <div class="max-w-5xl grid md:grid-cols-2 gap-8">
      <div class="icon-feature-large">
        <div class="text-4xl flex-shrink-0">⚖️</div>
        <div>
          <h3 class="mb-3">Law Firms & Courts</h3>
          <p class="text-neutral-600 mb-4">
            Same-day courthouse delivery. Our drivers know filing windows, security procedures, and Nanaimo court deadlines.
          </p>
          <a href="/industries" class="text-brand-blue font-semibold hover:underline">Explore legal →</a>
        </div>
      </div>

      <div class="icon-feature-large">
        <div class="text-4xl flex-shrink-0">🏥</div>
        <div>
          <h3 class="mb-3">Medical & Labs</h3>
          <p class="text-neutral-600 mb-4">
            Specimen transport with temperature control, chain-of-custody, and HIPAA-conscious handling.
          </p>
          <a href="/industries" class="text-brand-blue font-semibold hover:underline">Explore medical →</a>
        </div>
      </div>

      <div class="icon-feature-large">
        <div class="text-4xl flex-shrink-0">🏭</div>
        <div>
          <h3 class="mb-3">Manufacturing & Parts</h3>
          <p class="text-neutral-600 mb-4">
            Same-day parts delivery. Volume rates for print shops, auto suppliers, and equipment manufacturers.
          </p>
          <a href="/industries" class="text-brand-blue font-semibold hover:underline">Explore B2B →</a>
        </div>
      </div>

      <div class="icon-feature-large">
        <div class="text-4xl flex-shrink-0">🖨️</div>
        <div>
          <h3 class="mb-3">Print & Design</h3>
          <p class="text-neutral-600 mb-4">
            Rush proofs, final files, collateral. Same-day delivery for fast turnarounds.
          </p>
          <a href="/industries" class="text-brand-blue font-semibold hover:underline">Explore print →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <QuoteForm />

  <!-- Why Choose Us - Structured benefits -->
  <section class="bg-neutral-50 section-container">
    <div class="mb-12">
      <h2>Why {config.businessName}?</h2>
      <p class="text-lg text-neutral-600 max-w-2xl">We're not just faster—we're more reliable, more transparent, and built for the way you work.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl">
      <div class="icon-feature">
        <div class="text-4xl">🗺️</div>
        <h3 class="mb-3">Island Expertise</h3>
        <p class="text-neutral-600">Every driver knows the Malahat, ferry schedules, courthouse procedures, and hospital access points. We move faster because we know every road.</p>
      </div>

      <div class="icon-feature">
        <div class="text-4xl">📍</div>
        <h3 class="mb-3">Real-Time Tracking</h3>
        <p class="text-neutral-600">Track shipments live. Proof of delivery in minutes. You know exactly when it arrives—no guessing.</p>
      </div>

      <div class="icon-feature">
        <div class="text-4xl">💰</div>
        <h3 class="mb-3">Transparent Pricing</h3>
        <p class="text-neutral-600">No surprise surcharges. Flat rates for recurring business, volume discounts, monthly invoicing, and credit terms available.</p>
      </div>

      <div class="icon-feature">
        <div class="text-4xl">🔔</div>
        <h3 class="mb-3">24/7 Support</h3>
        <p class="text-neutral-600">After-hours emergency? Weekend rush? You talk to dispatch directly—not an answering service, not a voicemail.</p>
      </div>
    </div>
  </section>

  <!-- B2B CTA -->
  <B2BCTA />

  <!-- Coverage Map / Service Area -->
  <section class="section-container">
    <h2 class="text-center mb-8">Service Area: Central Vancouver Island</h2>

    <div class="bg-gray-100 rounded-lg p-8 text-center">
      <p class="text-gray-600 mb-4">
        Nanaimo as hub. Same-day service to Victoria, Duncan, Parksville, Qualicum, Port Alberni, Comox Valley, Campbell River, and everywhere in between.
      </p>
      <p class="text-sm text-gray-500 mb-4">
        [TODO: Static SVG map showing Nanaimo, major routes, ferry corridors, and service radius]
      </p>
      <a href="/routes/nanaimo-victoria" class="text-brand-blue font-semibold hover:underline">View all routes and transit times →</a>
    </div>
  </section>

  <!-- Hours / Contact Section -->
  <section class="bg-brand-dark text-white section-container" id="contact">
    <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8">
      <div>
        <h3 class="mb-4">Hours</h3>
        <p class="mb-2"><strong>Monday–Friday:</strong> {config.hours.weekday}</p>
        <p class="mb-4"><strong>Saturday–Sunday:</strong> {config.hours.weekend}</p>
        <p class="text-sm opacity-75">Emergency after-hours service available. Call for details.</p>
      </div>

      <div>
        <h3 class="mb-4">Get in Touch</h3>
        <a href={`mailto:${config.email}`} class="block text-brand-accent hover:underline mb-4">
          {config.email}
        </a>
        <div class="space-y-2">
          <a href="#quote" class="inline-block px-4 py-2 bg-brand-accent text-white rounded hover:bg-red-700 font-semibold text-sm">Get a Quote</a>
          <a href="/contact" class="inline-block px-4 py-2 bg-brand-blue text-white rounded hover:bg-blue-800 font-semibold text-sm ml-2">Contact Us</a>
        </div>
        <p class="text-sm opacity-75 mt-4">Submit a quote or message for quotes, emergency dispatch, and account setup.</p>
      </div>
    </div>
  </section>
</BaseLayout>
