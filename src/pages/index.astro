---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import B2BCTA from '../components/B2BCTA.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import { config } from '../config';

const title = 'Same-Day Courier Service in Nanaimo';
const description = `Reliable same-day courier and delivery service in Nanaimo, BC. Rush delivery, legal documents, medical specimens, and local routes. Get an instant quote online.`;
---

<BaseLayout {title} {description}>
  <SchemaMarkup type="LocalBusiness" />

  <!-- Hero Section — full-bleed Vancouver Island ferry banner -->
  <section class="relative text-white overflow-hidden">
    <!-- Full-bleed background photo -->
    <img
      src="/images/hero-island.jpg"
      alt="A BC Ferries vessel sailing between the Gulf Islands at sunset — a Vancouver Island courier route"
      width="1760"
      height="924"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <!-- Legibility overlays: dark on the left where the copy sits, sunset kept on the right -->
    <div class="absolute inset-0 bg-gradient-to-r from-brand-navy/95 via-brand-navy/75 to-brand-navy/25"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/85 via-transparent to-transparent"></div>

    <div class="max-w-6xl mx-auto px-5 py-24 md:py-36 relative">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-white/70 mb-6">
          Courier &amp; same-day delivery
        </p>
        <h1 class="text-white mb-8">
          Same-day courier across Vancouver Island.
        </h1>
        <p class="text-lg md:text-xl text-white/80 mb-10 max-w-xl leading-relaxed">
          Legal documents, medical specimens, retail pickup, and rush parcels — picked up in 30 minutes and tracked door to door, ferry routes included.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <PhoneCTA text="Get an instant quote" />
          <a href="/contact" class="cta-button-light">See the details</a>
        </div>
      </div>

      <!-- Trust stats strip -->
      <div class="grid grid-cols-2 gap-8 mt-20 pt-10 border-t border-white/15 max-w-md">
        <div>
          <div class="font-display text-4xl font-medium text-white mb-1">30 min</div>
          <div class="text-sm text-white/50">Average pickup</div>
        </div>
        <div>
          <div class="font-display text-4xl font-medium text-white mb-1">100%</div>
          <div class="text-sm text-white/50">On-time rate</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Numbered editorial panels — Boxly signature (white panels on dark) -->
  <section class="max-w-6xl mx-auto px-5 py-20 md:py-28 space-y-8">
    <div class="max-w-2xl mb-4">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-indigo mb-4">How we move your island</p>
      <h2 class="text-white">Streamline delivery with ease.</h2>
    </div>

    <!-- Panel 01 -->
    <div class="bg-white rounded-3xl p-8 md:p-12 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <div class="font-display text-2xl text-gray-400 mb-6">01</div>
        <h3 class="text-3xl mb-4">Speed you can count on</h3>
        <p class="mb-8 max-w-md">Pickup within 30 minutes and same-day delivery across Nanaimo and the surrounding islands — Victoria, Duncan, Parksville, Comox, and Port Alberni, ferry routes included.</p>
        <a href="/services/same-day-delivery" class="value-prop-cta">See the details →</a>
      </div>
      <div class="h-64 rounded-2xl bg-gray-100 border border-gray-200 flex flex-col items-center justify-center text-gray-400">
        <svg class="w-10 h-10 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M18 9.75h.008v.008H18V9.75z" /><rect x="2.25" y="4.5" width="19.5" height="15" rx="2" /></svg>
        <span class="text-sm">Photo placeholder</span>
      </div>
    </div>

    <!-- Panel 02 (offset) -->
    <div class="bg-white rounded-3xl p-8 md:p-12 grid lg:grid-cols-2 gap-10 items-center lg:ml-12">
      <div class="lg:order-2">
        <div class="font-display text-2xl text-gray-400 mb-6">02</div>
        <h3 class="text-3xl mb-4">Services for every need</h3>
        <p class="mb-8 max-w-md">Rush courier, medical specimens, legal documents, retail pickup — Walmart, grocery, IKEA — and scheduled routes. Each service tuned to your industry and timeline.</p>
        <a href="/services/rush-delivery" class="value-prop-cta">See the details →</a>
      </div>
      <div class="lg:order-1 h-64 rounded-2xl bg-gray-100 border border-gray-200 flex flex-col items-center justify-center text-gray-400">
        <svg class="w-10 h-10 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="2.25" y="4.5" width="19.5" height="15" rx="2" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159M18 9.75h.008v.008H18V9.75z" /></svg>
        <span class="text-sm">Photo placeholder</span>
      </div>
    </div>

    <!-- Panel 03 -->
    <div class="bg-white rounded-3xl p-8 md:p-12 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <div class="font-display text-2xl text-gray-400 mb-6">03</div>
        <h3 class="text-3xl mb-4">Built for business</h3>
        <p class="mb-8 max-w-md">Volume rates for recurring runs, real-time tracking, and photo proof of delivery. Trusted by law firms, medical facilities, manufacturers, and retailers across the island.</p>
        <a href="/industries" class="value-prop-cta">See the details →</a>
      </div>
      <div class="h-64 rounded-2xl bg-gray-100 border border-gray-200 flex flex-col items-center justify-center text-gray-400">
        <svg class="w-10 h-10 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="2.25" y="4.5" width="19.5" height="15" rx="2" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159M18 9.75h.008v.008H18V9.75z" /></svg>
        <span class="text-sm">Photo placeholder</span>
      </div>
    </div>
  </section>

  <!-- Services Grid — dark cards on the charcoal canvas -->
  <section class="section-container">
    <div class="mb-12">
      <h2>Our services</h2>
      <p class="text-lg text-gray-400 max-w-2xl">Comprehensive delivery solutions built for Nanaimo businesses, retailers, and professionals.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <!-- Delivery Services -->
      <a href="/services/same-day-delivery" class="service-card group cursor-pointer">
        <span class="service-category">Delivery</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">Same-Day Delivery</h3>
        <p class="text-gray-600 mb-4">
          Local Nanaimo within 3 hours. 3 PM cutoff weekdays, 10 AM weekends. Pickup guaranteed within 30 minutes.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/rush-delivery" class="service-card group cursor-pointer">
        <span class="service-category">Delivery</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">Rush & Emergency</h3>
        <p class="text-gray-600 mb-4">
          Priority dispatch for urgent shipments. Dedicated driver available. 24/7 emergency service for time-critical deliveries.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/medical-courier" class="service-card group cursor-pointer">
        <span class="service-category">Specialized</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">Medical & Lab</h3>
        <p class="text-gray-600 mb-4">
          Temperature-controlled specimen transport. Chain-of-custody handling. HIPAA-compliant documentation.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/legal-courier" class="service-card group cursor-pointer">
        <span class="service-category">Specialized</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">Legal Courier</h3>
        <p class="text-gray-600 mb-4">
          Court filings and legal document delivery. Certified drivers know courthouse procedures. Proof of delivery included.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/scheduled-delivery" class="service-card group cursor-pointer">
        <span class="service-category">B2B</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">Scheduled Routes</h3>
        <p class="text-gray-600 mb-4">
          Daily or weekly recurring routes. Flat rates with volume discounts. Dedicated dispatch contact.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/walmart-pickup" class="service-card group cursor-pointer">
        <span class="service-category">Retail</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">Walmart Pickup</h3>
        <p class="text-gray-600 mb-4">
          Order online, we collect and deliver. Same-day service to your home or office. No checkout lines.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/grocery-pickup" class="service-card group cursor-pointer">
        <span class="service-category">Retail</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">Grocery Delivery</h3>
        <p class="text-gray-600 mb-4">
          Fresh groceries from Save-On Foods and Thrifty Foods. Temperature-controlled delivery. Bulk orders welcome.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/services/ikea-delivery" class="service-card group cursor-pointer">
        <span class="service-category">Retail</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">IKEA Delivery & Assembly</h3>
        <p class="text-gray-600 mb-4">
          Furniture delivery from IKEA. Professional assembly included. Same-day pickup and installation available.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">Learn More →</span>
      </a>

      <a href="/routes/nanaimo-victoria" class="service-card group cursor-pointer">
        <span class="service-category">Routes</span>
        <h3 class="group-hover:text-brand-blue transition-colors mb-3">Island Routes</h3>
        <p class="text-gray-600 mb-4">
          Nanaimo to Victoria, Duncan, Parksville, Comox, and Port Alberni. Ferry routing included. Multi-stop service.
        </p>
        <span class="text-brand-blue font-semibold group-hover:underline">View Routes →</span>
      </a>
    </div>
  </section>

  <!-- Industry Solutions - Enterprise B2B -->
  <section class="section-container">
    <div class="mb-12">
      <h2>Industry Solutions</h2>
      <p class="text-lg text-gray-600 max-w-2xl">Specialized courier services built for the industries that depend on reliability and speed.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl">
      <div class="p-8 border border-gray-200 rounded hover:border-brand-blue transition-colors">
        <h3 class="text-xl font-bold text-gray-900 mb-3">Law Firms & Courts</h3>
        <p class="text-gray-600 mb-4">
          Same-day courthouse delivery. Our drivers know filing windows, security procedures, Nanaimo court deadlines, and courthouse-specific handling. Proof of delivery with signatures.
        </p>
        <a href="/industries" class="text-brand-blue font-semibold hover:text-brand-navy">Explore legal solutions →</a>
      </div>

      <div class="p-8 border border-gray-200 rounded hover:border-brand-blue transition-colors">
        <h3 class="text-xl font-bold text-gray-900 mb-3">Medical & Laboratory</h3>
        <p class="text-gray-600 mb-4">
          Specimen transport with temperature control, chain-of-custody documentation, and HIPAA-compliant handling. Certified for sensitive medical shipments.
        </p>
        <a href="/industries" class="text-brand-blue font-semibold hover:text-brand-navy">Explore medical solutions →</a>
      </div>

      <div class="p-8 border border-gray-200 rounded hover:border-brand-blue transition-colors">
        <h3 class="text-xl font-bold text-gray-900 mb-3">Manufacturing & Auto Parts</h3>
        <p class="text-gray-600 mb-4">
          Same-day parts delivery with volume rates. Recurring route options for auto suppliers, equipment manufacturers, and industrial facilities.
        </p>
        <a href="/industries" class="text-brand-blue font-semibold hover:text-brand-navy">Explore B2B logistics →</a>
      </div>

      <div class="p-8 border border-gray-200 rounded hover:border-brand-blue transition-colors">
        <h3 class="text-xl font-bold text-gray-900 mb-3">Print, Design & Retail</h3>
        <p class="text-gray-600 mb-4">
          Rush proofs, final files, marketing collateral, and retail pickups. Same-day delivery for fast turnarounds and inventory management.
        </p>
        <a href="/industries" class="text-brand-blue font-semibold hover:text-brand-navy">Explore retail solutions →</a>
      </div>
    </div>
  </section>

  <!-- Quote Form -->
  <QuoteForm />

  <!-- Why Choose Nanaimo Courier - Differentiators -->
  <section class="bg-gray-50 section-container">
    <div class="mb-12">
      <h2>Why Choose {config.businessName}</h2>
      <p class="text-lg text-gray-600 max-w-2xl">Reliable, transparent, and built for the way Nanaimo businesses operate.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl">
      <div class="p-6 border-l-4 border-brand-blue bg-white rounded">
        <h3 class="text-lg font-bold text-gray-900 mb-3">Island-Wide Expertise</h3>
        <p class="text-gray-600">Every driver knows the Malahat, ferry schedules, courthouse procedures, and hospital access points. Speed comes from knowing every road and route.</p>
      </div>

      <div class="p-6 border-l-4 border-brand-blue bg-white rounded">
        <h3 class="text-lg font-bold text-gray-900 mb-3">Real-Time Visibility</h3>
        <p class="text-gray-600">Live GPS tracking on every delivery. Proof of delivery with photos and signatures. Transparency from dispatch to doorstep.</p>
      </div>

      <div class="p-6 border-l-4 border-brand-blue bg-white rounded">
        <h3 class="text-lg font-bold text-gray-900 mb-3">Fixed, Predictable Pricing</h3>
        <p class="text-gray-600">No surprise fees. Flat rates for one-off shipments. Volume discounts for recurring routes. Monthly invoicing and credit terms for established clients.</p>
      </div>

      <div class="p-6 border-l-4 border-brand-blue bg-white rounded">
        <h3 class="text-lg font-bold text-gray-900 mb-3">Direct Dispatch Access</h3>
        <p class="text-gray-600">24/7 support. After-hours emergency? Weekend rush? You reach dispatch directly—not an answering service. We talk to you, not a voicemail.</p>
      </div>
    </div>
  </section>

  <!-- B2B CTA -->
  <B2BCTA />

  <!-- Service Coverage -->
  <section class="bg-gray-50 section-container">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-center mb-4">Service Coverage: Central Vancouver Island</h2>
      <p class="text-center text-gray-600 mb-8 text-lg">Nanaimo-based with same-day delivery across Vancouver Island and quick-response service to all surrounding communities.</p>

      <div class="bg-white border border-gray-200 rounded-lg p-8">
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <div>
            <h4 class="font-bold text-gray-900 mb-3">Local Nanaimo</h4>
            <ul class="text-gray-600 space-y-2 text-sm">
              <li>• 30-minute pickup</li>
              <li>• 3-hour delivery guarantee</li>
              <li>• All neighborhoods</li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 mb-3">Southern VI</h4>
            <ul class="text-gray-600 space-y-2 text-sm">
              <li>• Victoria (ferry + route)</li>
              <li>• Duncan</li>
              <li>• Lake Cowichan</li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 mb-3">Northern VI</h4>
            <ul class="text-gray-600 space-y-2 text-sm">
              <li>• Parksville & Qualicum</li>
              <li>• Port Alberni</li>
              <li>• Comox Valley</li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-6">
          <a href="/routes/nanaimo-victoria" class="inline-flex items-center px-6 py-3 bg-brand-blue text-white font-semibold rounded hover:bg-brand-navy transition-colors">
            View All Routes & Transit Times →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hours / Contact Section - Enterprise Footer CTA -->
  <section class="bg-brand-navy text-white section-container" id="contact">
    <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-12">
      <div>
        <h3 class="text-xl font-bold mb-6">Business Hours</h3>
        <div class="space-y-4">
          <div>
            <p class="font-semibold mb-1">Monday–Friday</p>
            <p class="text-white/80">{config.hours.weekday}</p>
          </div>
          <div>
            <p class="font-semibold mb-1">Saturday–Sunday</p>
            <p class="text-white/80">{config.hours.weekend}</p>
          </div>
          <p class="text-sm text-white/70 mt-4">24/7 emergency dispatch available. Contact us after hours for urgent requests.</p>
        </div>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-6">Get Started</h3>
        <p class="text-white/80 mb-6">Ready to streamline your delivery needs?</p>
        <div class="flex flex-col gap-3">
          <a href="#quote" class="inline-flex items-center justify-center px-6 py-3 bg-brand-blue text-white font-semibold rounded hover:bg-white hover:text-brand-navy transition-colors">
            Request a Quote
          </a>
          <a href={`mailto:${config.email}`} class="inline-flex items-center justify-center px-6 py-3 border-2 border-white text-white font-semibold rounded hover:bg-white hover:text-brand-navy transition-colors">
            {config.email}
          </a>
        </div>
        <p class="text-xs text-white/60 mt-6">Send us a message for quotes, emergency dispatch, account setup, or special requests.</p>
      </div>
    </div>
  </section>
</BaseLayout>
