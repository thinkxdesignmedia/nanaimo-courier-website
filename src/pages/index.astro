---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import B2BCTA from '../components/B2BCTA.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import { config } from '../config';

const title = 'Same-Day Courier Service in Nanaimo';
const description = `Reliable same-day courier and delivery service in Nanaimo, BC. Rush delivery, legal documents, medical specimens, and local routes. Get an instant quote online.`;
---

<BaseLayout {title} {description} preloadImage="/images/hero-island.webp">
  <SchemaMarkup type="LocalBusiness" />

  <!-- Hero Section — Boxly giant-wordmark style -->
  <section class="bg-brand-dark overflow-hidden">
    <div class="max-w-[1700px] mx-auto px-5 pt-10 md:pt-14">
      <!-- Giant wordmark -->
      <h1
        class="relative z-10 font-display font-bold text-gray-200 uppercase leading-[0.82] tracking-tight whitespace-nowrap"
        style="font-size: clamp(3.5rem, 22.5vw, 21rem)"
      >
        Courier
      </h1>

      <!-- Full-bleed hero image, pulled up to slightly overlap the wordmark -->
      <div class="relative -mt-4 md:-mt-12">
        <picture>
          <source srcset="/images/hero-island.webp" type="image/webp" />
          <img
            src="/images/hero-island.jpg"
            alt="A BC Ferries vessel sailing between the Gulf Islands at sunset — a Vancouver Island courier route"
            width="1760"
            height="924"
            fetchpriority="high"
            class="w-full h-[42vh] md:h-[64vh] object-cover rounded-2xl"
          />
        </picture>
      </div>

      <!-- Copy row under the image -->
      <div class="grid md:grid-cols-3 gap-10 mt-10 md:mt-14">
        <!-- Location -->
        <div>
          <div class="flex items-center gap-3 text-sm font-medium uppercase tracking-wide text-white">
            <span class="w-2.5 h-2.5 rounded-full bg-white"></span> Nanaimo, BC
          </div>
        </div>

        <!-- Lets ship / email -->
        <div>
          <p class="text-xs uppercase tracking-widest text-gray-400 mb-2">Let's ship</p>
          <a href={`mailto:${config.email}`} class="text-white hover:opacity-80 break-all">{config.email}</a>
        </div>

        <!-- Description + feature list + CTA -->
        <div>
          <p class="text-gray-200 leading-relaxed">
            {config.businessName} delivers same-day courier and delivery across Vancouver Island — connecting your shipments with speed, clarity, and trust.
          </p>
          <div class="border-t border-white/15 my-6"></div>
          <ul class="space-y-1.5 text-white text-sm mb-7">
            <li>Island-wide reach</li>
            <li>Secure handling</li>
            <li>Clear, fixed pricing</li>
            <li>Same-day delivery</li>
            <li>Trusted local team</li>
          </ul>
          <PhoneCTA text="Get an instant quote" />
        </div>
      </div>
    </div>
  </section>

  <!-- Numbered editorial panels — Boxly staggered white panels with collages -->
  <section class="max-w-6xl mx-auto px-5 py-20 md:py-28">
    <!-- Two-tone intro headline + right paragraph -->
    <div class="grid lg:grid-cols-[1.5fr_1fr] gap-8 lg:gap-16 items-start mb-14 md:mb-20">
      <h2 class="!mb-0">
        <span class="text-white">Streamline delivery with ease.</span>
        <span class="text-gray-500"> Moving island freight with skill</span>
        <span class="text-white"> to keep the coast connected.</span>
      </h2>
      <p class="text-gray-400 lg:pt-3">
        {config.businessName} is dedicated to making local delivery simple, fast, and reliable — secure, same-day courier and pickup across Vancouver Island.
      </p>
    </div>

    <!-- Panel 01 (right-aligned, single image) -->
    <div class="relative bg-white rounded-3xl overflow-hidden shadow-2xl shadow-black/30 lg:w-[86%] lg:ml-auto grid lg:grid-cols-2">
      <div class="p-8 md:p-12 flex flex-col min-h-[20rem]">
        <div class="font-display text-xl text-gray-400 mb-6">01</div>
        <h3 class="text-3xl mb-4">Speed you can count on</h3>
        <p class="max-w-md">Pickup within 30 minutes and same-day delivery across Nanaimo and the surrounding islands — Victoria, Duncan, Parksville, Comox, and Port Alberni, ferry routes included.</p>
        <a href="/services/same-day-delivery" class="value-prop-cta mt-auto pt-10">See the details →</a>
      </div>
      <div class="min-h-[16rem] lg:min-h-full">
        <picture>
          <source srcset="/images/courier-runner-two.webp" type="image/webp" />
          <img
            src="/images/courier-runner-two.jpg"
            alt="A Nanaimo courier running to make a fast same-day delivery"
            width="1400"
            height="933"
            loading="lazy"
            class="w-full h-full min-h-[16rem] object-cover"
          />
        </picture>
      </div>
    </div>

    <!-- Panel 02 (left-aligned, overlaps up, two images) -->
    <div class="relative mt-6 lg:-mt-12 bg-white rounded-3xl overflow-hidden shadow-2xl shadow-black/30 lg:w-[86%] lg:mr-auto grid lg:grid-cols-2">
      <div class="p-8 md:p-12 flex flex-col min-h-[20rem]">
        <div class="font-display text-xl text-gray-400 mb-6">02</div>
        <h3 class="text-3xl mb-4">Services for every need</h3>
        <p class="max-w-md">Rush courier, medical specimens, legal documents, retail pickup — Walmart, grocery, IKEA — and scheduled routes. Each service tuned to your industry and timeline.</p>
        <a href="/services/rush-delivery" class="value-prop-cta mt-auto pt-10">See the details →</a>
      </div>
      <div class="min-h-[16rem] lg:min-h-full">
        <picture>
          <source srcset="/images/courier-packages.webp" type="image/webp" />
          <img
            src="/images/courier-packages.jpg"
            alt="A courier assembling IKEA-style flat-pack furniture after delivery"
            width="1400"
            height="933"
            loading="lazy"
            class="w-full h-full min-h-[16rem] object-cover"
          />
        </picture>
      </div>
    </div>

    <!-- Panel 03 (right-aligned, overlaps up, one wide + two small) -->
    <div class="relative mt-6 lg:-mt-12 bg-white rounded-3xl overflow-hidden shadow-2xl shadow-black/30 lg:w-[86%] lg:ml-auto grid lg:grid-cols-2">
      <div class="p-8 md:p-12 flex flex-col min-h-[22rem]">
        <div class="font-display text-xl text-gray-400 mb-6">03</div>
        <h3 class="text-3xl mb-4">Built for business</h3>
        <p class="max-w-md">Volume rates for recurring runs, real-time tracking, and photo proof of delivery. Trusted by law firms, medical facilities, manufacturers, and retailers across the island.</p>
        <a href="/industries" class="value-prop-cta mt-auto pt-10">See the details →</a>
      </div>
      <div class="min-h-[18rem] lg:min-h-full">
        <picture>
          <source srcset="/images/courier-business.webp" type="image/webp" />
          <img
            src="/images/courier-business.jpg"
            alt="A Nanaimo courier delivering a package to a corporate office reception desk"
            width="1400"
            height="781"
            loading="lazy"
            class="w-full h-full min-h-[18rem] object-cover"
          />
        </picture>
      </div>
    </div>
  </section>

  <!-- Services — Boxly: intro column + image-top cards with dividers -->
  <section class="relative overflow-hidden">
    <!-- Faded background wordmark -->
    <span class="pointer-events-none select-none absolute -top-4 left-0 right-0 text-center font-display font-bold uppercase text-white/[0.03] leading-none tracking-tight text-[16vw]" aria-hidden="true">Services</span>

    <div class="relative max-w-6xl mx-auto px-5 py-20 md:py-28">
      <div class="grid lg:grid-cols-4 gap-x-8 gap-y-14">
        <!-- Intro column -->
        <div class="lg:pr-6 flex flex-col">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand-iris mb-4">Island logistics</p>
          <h2 class="!text-3xl md:!text-4xl !mb-5">Moving your island with care</h2>
          <p class="text-gray-400 mb-8">We handle every shipment with care and deliver fast, reliable courier and pickup across Vancouver Island.</p>
          <a href="#quote" class="cta-button self-start mt-auto">Get a quote</a>
        </div>

        <!-- Cards -->
        <a href="/services/same-day-delivery" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/same-day.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">Same-Day Delivery</h3>
          <p class="text-gray-400 text-sm">Local Nanaimo within 3 hours. Pickup guaranteed in 30 minutes.</p>
        </a>

        <a href="/services/rush-delivery" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/rush.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">Rush & Emergency</h3>
          <p class="text-gray-400 text-sm">Priority dispatch for urgent shipments. 24/7 emergency service.</p>
        </a>

        <a href="/services/medical-courier" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/medical.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">Medical & Lab</h3>
          <p class="text-gray-400 text-sm">Temperature-controlled specimens. Chain-of-custody handling.</p>
        </a>

        <a href="/services/legal-courier" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/legal.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">Legal Courier</h3>
          <p class="text-gray-400 text-sm">Court filings and legal documents. Proof of delivery included.</p>
        </a>

        <a href="/services/scheduled-delivery" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/scheduled.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">Scheduled Routes</h3>
          <p class="text-gray-400 text-sm">Daily or weekly recurring routes. Flat rates, volume discounts.</p>
        </a>

        <a href="/services/walmart-pickup" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/walmart.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">Walmart Pickup</h3>
          <p class="text-gray-400 text-sm">Order online, we collect and deliver. Same-day to your door.</p>
        </a>

        <a href="/services/grocery-pickup" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/grocery.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">Grocery Delivery</h3>
          <p class="text-gray-400 text-sm">Fresh groceries from Save-On and Thrifty Foods. Bulk orders welcome.</p>
        </a>

        <a href="/services/ikea-delivery" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/ikea.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">IKEA Delivery</h3>
          <p class="text-gray-400 text-sm">Furniture delivery and professional assembly. Same-day pickup.</p>
        </a>

        <a href="/routes/nanaimo-victoria" class="group lg:border-l lg:border-white/10 lg:pl-8 [&:nth-child(4n+1)]:lg:border-l-0 [&:nth-child(4n+1)]:lg:pl-0">
          <div class="mb-6 flex items-center">
            <img src="/images/services/routes.svg" alt="" width="80" height="80" loading="lazy" class="w-20 h-20 transition-transform group-hover:scale-105" />
          </div>
          <h3 class="text-xl mb-2 group-hover:text-brand-indigo transition-colors">Island Routes</h3>
          <p class="text-gray-400 text-sm">Victoria, Duncan, Parksville, Comox, Port Alberni. Ferry routing.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Industry Solutions -->
  <section class="section-container">
    <div class="mb-14 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-iris mb-4">Who we serve</p>
      <h2>Built for the industries that can't wait.</h2>
      <p class="text-lg text-gray-400 mt-5">Specialized courier service for the sectors that depend on reliability and speed.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
      <a href="/industries" class="service-card group">
        <span class="service-category">Legal</span>
        <h3 class="text-2xl mb-3 group-hover:text-brand-indigo transition-colors">Law Firms & Courts</h3>
        <p class="mb-5">Same-day courthouse delivery. Our drivers know filing windows, security procedures, Nanaimo court deadlines, and courthouse-specific handling — with signed proof of delivery.</p>
        <span class="inline-flex items-center gap-1.5 text-brand-iris font-medium">Explore legal solutions →</span>
      </a>

      <a href="/industries" class="service-card group">
        <span class="service-category">Medical</span>
        <h3 class="text-2xl mb-3 group-hover:text-brand-indigo transition-colors">Medical & Laboratory</h3>
        <p class="mb-5">Specimen transport with temperature control, chain-of-custody documentation, and HIPAA-conscious handling. Certified for sensitive medical shipments.</p>
        <span class="inline-flex items-center gap-1.5 text-brand-iris font-medium">Explore medical solutions →</span>
      </a>

      <a href="/industries" class="service-card group">
        <span class="service-category">Industrial</span>
        <h3 class="text-2xl mb-3 group-hover:text-brand-indigo transition-colors">Manufacturing & Auto Parts</h3>
        <p class="mb-5">Same-day parts delivery with volume rates. Recurring route options for auto suppliers, equipment manufacturers, and industrial facilities.</p>
        <span class="inline-flex items-center gap-1.5 text-brand-iris font-medium">Explore B2B logistics →</span>
      </a>

      <a href="/industries" class="service-card group">
        <span class="service-category">Retail</span>
        <h3 class="text-2xl mb-3 group-hover:text-brand-indigo transition-colors">Print, Design & Retail</h3>
        <p class="mb-5">Rush proofs, final files, marketing collateral, and retail pickups. Same-day delivery for fast turnarounds and inventory management.</p>
        <span class="inline-flex items-center gap-1.5 text-brand-iris font-medium">Explore retail solutions →</span>
      </a>
    </div>
  </section>

  <!-- Quote Form -->
  <QuoteForm />

  <!-- Why Choose Nanaimo Courier -->
  <section class="section-container">
    <div class="mb-14 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-indigo mb-4">Why us</p>
      <h2>Why choose {config.businessName}</h2>
      <p class="text-lg text-gray-400 mt-5">Reliable, transparent, and built for the way Nanaimo businesses operate.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 max-w-5xl">
      <div class="service-card">
        <h3 class="text-xl mb-3">Island-Wide Expertise</h3>
        <p>Every driver knows the Malahat, ferry schedules, courthouse procedures, and hospital access points. Speed comes from knowing every road and route.</p>
      </div>

      <div class="service-card">
        <h3 class="text-xl mb-3">Real-Time Visibility</h3>
        <p>Live GPS tracking on every delivery. Proof of delivery with photos and signatures. Transparency from dispatch to doorstep.</p>
      </div>

      <div class="service-card">
        <h3 class="text-xl mb-3">Fixed, Predictable Pricing</h3>
        <p>No surprise fees. Flat rates for one-off shipments. Volume discounts for recurring routes. Monthly invoicing and credit terms for established clients.</p>
      </div>

      <div class="service-card">
        <h3 class="text-xl mb-3">Direct Dispatch Access</h3>
        <p>24/7 support. After-hours emergency? Weekend rush? You reach dispatch directly — not an answering service, not a voicemail.</p>
      </div>
    </div>
  </section>

  <!-- B2B CTA -->
  <B2BCTA />

  <!-- Service Coverage -->
  <section class="section-container">
    <div class="mb-14 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-indigo mb-4">Coverage</p>
      <h2>Same-day across central Vancouver Island.</h2>
      <p class="text-lg text-gray-400 mt-5">Nanaimo-based, with same-day delivery and quick-response service to every surrounding community.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mb-10">
      <div class="service-card">
        <h3 class="text-lg mb-4">Local Nanaimo</h3>
        <ul class="text-gray-400 space-y-2 text-sm">
          <li>30-minute pickup</li>
          <li>3-hour delivery guarantee</li>
          <li>All neighbourhoods</li>
        </ul>
      </div>
      <div class="service-card">
        <h3 class="text-lg mb-4">Southern VI</h3>
        <ul class="text-gray-400 space-y-2 text-sm">
          <li>Victoria (ferry + route)</li>
          <li>Duncan</li>
          <li>Lake Cowichan</li>
        </ul>
      </div>
      <div class="service-card">
        <h3 class="text-lg mb-4">Northern VI</h3>
        <ul class="text-gray-400 space-y-2 text-sm">
          <li>Parksville & Qualicum</li>
          <li>Port Alberni</li>
          <li>Comox Valley</li>
        </ul>
      </div>
    </div>

    <a href="/routes/nanaimo-victoria" class="cta-button">View all routes &amp; transit times →</a>
  </section>

  <!-- Hours / Contact Section -->
  <section class="section-container" id="contact">
    <div class="max-w-5xl mx-auto">
      <div class="mb-14 max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-iris mb-4">Get in touch</p>
        <h2>Ready when you are.</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-xl mb-6">Business hours</h3>
          <div class="space-y-4">
            <div>
              <p class="text-white font-semibold mb-1">Monday–Friday</p>
              <p class="text-gray-400">{config.hours.weekday}</p>
            </div>
            <div>
              <p class="text-white font-semibold mb-1">Saturday–Sunday</p>
              <p class="text-gray-400">{config.hours.weekend}</p>
            </div>
            <p class="text-sm text-gray-500 mt-4">24/7 emergency dispatch available. Contact us after hours for urgent requests.</p>
          </div>
        </div>

        <div>
          <h3 class="text-xl mb-6">Get started</h3>
          <p class="text-gray-400 mb-8">Ready to streamline your delivery needs?</p>
          <div class="flex flex-col items-start gap-4">
            <a href="#quote" class="cta-button whitespace-nowrap">Request a quote</a>
            <a href={`mailto:${config.email}`} class="cta-button-outline whitespace-nowrap">{config.email}</a>
          </div>
          <p class="text-xs text-gray-500 mt-6">Send a message for quotes, emergency dispatch, account setup, or special requests.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
