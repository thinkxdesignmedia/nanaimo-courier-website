---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import { config } from '../../config';

const title = 'Nanaimo to Parksville & Qualicum Courier';
const description = 'Same-day courier from Nanaimo to Parksville, Qualicum Beach. 45 minutes delivery. Tourism, retail, seasonal services.';
---

<BaseLayout {title} {description}>
  <SchemaMarkup type="Service" data={{ serviceName: 'Nanaimo to Parksville Route', description }} />

  <section class="bg-gradient-to-br from-brand-dark via-brand-blue to-brand-dark text-white py-12 md:py-16">
    <div class="section-container">
      <h1 class="text-white mb-4">Nanaimo to Parksville & Qualicum Beach</h1>
      <p class="text-lg md:text-xl opacity-95 mb-8 max-w-2xl">
        Quick same-day courier to Parksville and Qualicum Beach. 30–45 minutes delivery. Retail, tourism, seasonal events.
      </p>
      <PhoneCTA text={`Get Quote: ${config.phone}`} />
    </div>
  </section>

  <section class="section-container">
    <h2>Nanaimo ↔ Parksville/Qualicum Route Details</h2>

    <div class="bg-gray-50 p-6 rounded mb-8">
      <h3 class="font-bold mb-4 text-brand-blue">Quick Facts</h3>
      <ul class="space-y-2 text-gray-700 text-sm">
        <li><strong>Distance:</strong> ~30 km via Highway 19 South</li>
        <li><strong>Drive time:</strong> 30 minutes direct</li>
        <li><strong>Total typical:</strong> 45 minutes to 1 hour door-to-door</li>
        <li><strong>Traffic:</strong> Minimal. Summer tourism can add 5–10 minutes.</li>
        <li><strong>Cost:</strong> $18 base + $1.50/km = ~$63 typical</li>
        <li><strong>Best for:</strong> Fastest turnaround on Vancouver Island</li>
      </ul>
    </div>
  </section>

  <section class="bg-blue-50 section-container">
    <h2>Same-Day Cutoff: Parksville & Qualicum</h2>

    <div class="space-y-4 max-w-3xl">
      <div class="bg-white p-6 rounded border-l-4 border-brand-accent">
        <h3 class="font-bold mb-2">Parksville/Qualicum</h3>
        <p class="text-lg text-brand-accent font-semibold">3:00 PM cutoff (weekdays)</p>
        <p class="text-gray-700 text-sm mt-1">Order by 3 PM, delivery by 4–4:30 PM. Fastest turn-around on the island.</p>
      </div>

      <div class="bg-white p-6 rounded border-l-4 border-brand-accent">
        <h3 class="font-bold mb-2">Friday</h3>
        <p class="text-lg text-brand-accent font-semibold">2:00 PM cutoff</p>
        <p class="text-gray-700 text-sm mt-1">Plan ahead for Friday. Weekend delivery not guaranteed until Monday.</p>
      </div>

      <div class="bg-white p-6 rounded border-l-4 border-brand-accent">
        <h3 class="font-bold mb-2">Evenings & Weekends</h3>
        <p class="text-gray-700 text-sm">
          Call for availability. Same 45-minute route works after hours with rush surcharge.
        </p>
      </div>
    </div>
  </section>

  <section class="section-container">
    <h2>Parksville/Qualicum Pricing</h2>

    <div class="max-w-2xl bg-gray-50 p-6 rounded mb-8">
      <h3 class="font-bold mb-4">Standard Rate</h3>
      <p class="text-gray-700 mb-4">
        $18 base + (30 km × $1.50) = <span class="text-lg font-bold text-brand-accent">~$63</span>
      </p>
      <p class="text-sm text-gray-600">
        One of the cheapest courier runs on the island due to short distance and high traffic frequency.
      </p>
    </div>
  </section>

  <QuoteForm />
</BaseLayout>
