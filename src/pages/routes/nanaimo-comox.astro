---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import { config } from '../../config';

const title = 'Nanaimo to Comox Valley Courier | Campbell River Delivery';
const description = 'Same-day courier from Nanaimo to Comox Valley and Campbell River. 1.5–2 hour delivery. Rush delivery, medical samples, legal documents.';
---

<BaseLayout {title} {description}>
  <SchemaMarkup type="Service" data={{ serviceName: 'Nanaimo to Comox Valley Route', description }} />

  <section class="bg-gradient-to-r from-brand-navy to-brand-blue text-white py-12 md:py-16">
    <div class="section-container">
      <h1 class="text-white mb-4">Nanaimo to Comox Valley & Campbell River</h1>
      <p class="text-lg md:text-xl opacity-95 mb-8 max-w-2xl">
        Fast courier from Nanaimo north to Comox Valley, Campbell River, and beyond. 1.5–2 hour delivery. Highway 19 direct route, no ferries.
      </p>
      <PhoneCTA text="Get Quote" />
    </div>
  </section>

  <section class="section-container">
    <h2>Route Specifics: Nanaimo → Comox Valley & Campbell River</h2>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="bg-gray-50 p-6 rounded">
        <h3 class="font-bold mb-4 text-brand-blue">To Comox Valley (Courtenay/Comox)</h3>
        <ul class="space-y-2 text-gray-700 text-sm">
          <li><strong>Distance:</strong> ~100 km via Highway 19 North</li>
          <li><strong>Drive time:</strong> 1 hour direct</li>
          <li><strong>Total typical:</strong> 1.5–2 hours door-to-door</li>
          <li><strong>Traffic:</strong> Minimal. Straight shot north.</li>
          <li><strong>Cost:</strong> $35 base + $2.00/km = ~$235 typical</li>
          <li><strong>Best for:</strong> Same-day rush, predictable timing</li>
        </ul>
      </div>

      <div class="bg-gray-50 p-6 rounded">
        <h3 class="font-bold mb-4 text-brand-blue">To Campbell River</h3>
        <ul class="space-y-2 text-gray-700 text-sm">
          <li><strong>Distance:</strong> ~150 km via Highway 19 North</li>
          <li><strong>Drive time:</strong> 1.5 hours direct</li>
          <li><strong>Total typical:</strong> 2–2.5 hours door-to-door</li>
          <li><strong>Traffic:</strong> Comox Valley passes through, but doesn't back up courier</li>
          <li><strong>Cost:</strong> $35 base + $2.00/km = ~$335 typical</li>
          <li><strong>Best for:</strong> Next-day option if same-day urgent cutoff missed</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 section-container">
    <h2>Same-Day Cutoff Times: Nanaimo to Comox Valley</h2>

    <div class="space-y-4 max-w-3xl">
      <div class="bg-white p-6 rounded border-l-4 border-brand-blue">
        <h3 class="font-bold mb-2">Comox Valley (Courtenay/Comox)</h3>
        <p class="text-lg text-brand-blue font-semibold">12:00 PM (Noon) cutoff</p>
        <p class="text-gray-700 text-sm mt-1">Order by noon, delivery by 2–2:30 PM. Perfect for time-sensitive deliveries.</p>
      </div>

      <div class="bg-white p-6 rounded border-l-4 border-brand-blue">
        <h3 class="font-bold mb-2">Campbell River</h3>
        <p class="text-lg text-brand-blue font-semibold">11:00 AM cutoff</p>
        <p class="text-gray-700 text-sm mt-1">Earlier cutoff due to extra 30 minutes of drive time. Order by 11 AM for 2–3 PM delivery.</p>
      </div>

      <div class="bg-white p-6 rounded border-l-4 border-brand-blue">
        <h3 class="font-bold mb-2">After Cutoff?</h3>
        <p class="text-gray-700 text-sm">
          Call for rush pricing. We may still expedite to Comox Valley same-day. Campbell River likely next-day at that point.
        </p>
      </div>
    </div>
  </section>

  <section class="section-container">
    <h2>Who Uses This Route</h2>

    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="card">
        <h3>RGN Hospital & Medical Clinics</h3>
        <p class="text-gray-600">Specimen pickup, lab results delivery, urgent medical transport.</p>
      </div>

      <div class="card">
        <h3>Comox Valley Businesses</h3>
        <p class="text-gray-600">Parts delivery, documentation, inter-office courier, rush orders.</p>
      </div>

      <div class="card">
        <h3>Campbell River Manufacturing</h3>
        <p class="text-gray-600">Same-day parts delivery, rush freight between facilities.</p>
      </div>

      <div class="card">
        <h3>Seasonal Tourism & Events</h3>
        <p class="text-gray-600">Event materials, marketing collateral, same-day delivery for conferences.</p>
      </div>
    </div>
  </section>

  <section class="section-container">
    <h2>Common Nanaimo ↔ Comox Valley & Campbell River Scenarios</h2>

    <div class="space-y-4">
      <div class="border-l-4 border-brand-blue bg-gray-50 p-6 rounded">
        <h3 class="font-bold mb-2">RGN Hospital & Medical Clinics</h3>
        <p class="text-gray-700">
          Specimen pickup from Nanaimo clinic (9 AM), transport to Comox Valley lab by 10:30 AM. Temperature-controlled, chain-of-custody documented. Cost: ~$235 + $10 temp control.
        </p>
      </div>

      <div class="border-l-4 border-brand-blue bg-gray-50 p-6 rounded">
        <h3 class="font-bold mb-2">Manufacturing Parts Delivery</h3>
        <p class="text-gray-700">
          Nanaimo warehouse ships urgent parts by 11 AM, delivery to Comox Valley factory by 12:30 PM. Production line depends on it. Cost: ~$235 standard, ~$350 if rush (after noon).
        </p>
      </div>

      <div class="border-l-4 border-brand-blue bg-gray-50 p-6 rounded">
        <h3 class="font-bold mb-2">Campbell River Lumber/Industrial</h3>
        <p class="text-gray-700">
          Equipment failure at Campbell River mill. Parts sourced in Nanaimo by 10 AM, pickup 10:30 AM, delivery 12:30 PM. Cost: ~$335 standard, ~$500 if rush.
        </p>
      </div>

      <div class="border-l-4 border-brand-blue bg-gray-50 p-6 rounded">
        <h3 class="font-bold mb-2">Multi-Stop Tourism/Events</h3>
        <p class="text-gray-700">
          Conference materials: pickup Nanaimo, delivery to Courtenay hotel + Comox venue + Campbell River resort. Single route, 3 stops. Cost: ~$235 + $5 per stop = ~$245 total.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 section-container">
    <h2>Comox Valley & Campbell River Pricing & Cost Examples</h2>

    <div class="max-w-2xl">
      <p class="text-gray-700 mb-6">
        Comox Valley (Courtenay/Comox) is faster and cheaper than Campbell River. Choose based on urgency and destination.
      </p>

      <div class="bg-white p-6 rounded border border-gray-300 mb-6 space-y-4">
        <div class="pb-4 border-b">
          <h3 class="font-bold mb-1">To Comox Valley (Courtenay/Comox)</h3>
          <p class="text-gray-700">$35 base + (100 km × $2.00) = <span class="text-lg font-bold text-brand-blue">~$235</span></p>
          <p class="text-xs text-gray-600 mt-1">Standard 1.5–2 hour delivery. Best for speed and cost. Example: Medical clinic to Comox Valley hospital.</p>
        </div>

        <div class="pb-4 border-b">
          <h3 class="font-bold mb-1">To Comox Valley + Temperature Control</h3>
          <p class="text-gray-700">$235 + $10 (refrigerated) = <span class="text-lg font-bold text-brand-blue">~$245</span></p>
          <p class="text-xs text-gray-600 mt-1">Specimen delivery to RGN lab. Common for medical offices.</p>
        </div>

        <div class="pb-4 border-b">
          <h3 class="font-bold mb-1">To Campbell River</h3>
          <p class="text-gray-700">$35 base + (150 km × $2.00) = <span class="text-lg font-bold text-brand-blue">~$335</span></p>
          <p class="text-xs text-gray-600 mt-1">Longer drive (2–2.5 hours). Used less frequently; manufacturing parts, lumber goods.</p>
        </div>

        <div class="pb-4 border-b">
          <h3 class="font-bold mb-1">Rush Multiplier (After 12 PM Comox)</h3>
          <p class="text-gray-700">$235 × 1.5 = <span class="text-lg font-bold text-brand-blue">~$350</span></p>
          <p class="text-xs text-gray-600 mt-1">Emergency order after noon. Drivers available but timing tightens. Still same-day if early enough.</p>
        </div>

        <div>
          <h3 class="font-bold mb-1">Multi-Stop (Courtenay + Comox + Campbell River)</h3>
          <p class="text-gray-700">$35 + (100 km × $2.00) + (50 km × $2.00) + ($5 × 2 stops) = <span class="text-lg font-bold text-brand-blue">~$295</span></p>
          <p class="text-xs text-gray-600 mt-1">Single efficient route covering all three centers. Example: Conference materials delivery.</p>
        </div>
      </div>

      <p class="text-sm text-gray-600">
        Regular Comox Valley users? Monthly account rates ($150–$200/run, 30–50% savings) available. RGN hospital partnerships common.
      </p>
    </div>
  </section>

  <QuoteForm />

  <section class="section-container">
    <h2>Comox Valley Route FAQ</h2>

    <div class="space-y-6 max-w-3xl">
      <div>
        <h3 class="font-bold mb-2">Is Highway 19 North reliable in winter?</h3>
        <p class="text-gray-700">
          Generally yes. North Island Highway 19 is well-maintained year-round. Snow is rare; rain is typical. We monitor conditions and notify you if delays expected. Winter cutoff may shift earlier (11 AM instead of noon) in heavy snow.
        </p>
      </div>

      <div>
        <h3 class="font-bold mb-2">Can I split one order to Courtenay AND Campbell River?</h3>
        <p class="text-gray-700">
          Yes. Courtenay stop + Campbell River stop = combined route. We quote based on total distance/stops (~$295–$350 for both). Single driver, single invoice, both delivered same-day.
        </p>
      </div>

      <div>
        <h3 class="font-bold mb-2">What's faster: Comox Valley or Campbell River for urgent medical?</h3>
        <p class="text-gray-700">
          Comox Valley is 30 minutes faster (1.5 hrs vs. 2.5 hrs). If speed is critical, Comox is more reliably same-day. Campbell River often requires earlier order (11 AM vs. noon) for same-day guarantee.
        </p>
      </div>

      <div>
        <h3 class="font-bold mb-2">Do RGN Hospital and Comox clinics use you regularly?</h3>
        <p class="text-gray-700">
          Yes. We handle specimen runs for regional labs. Daily standing orders available: 3 PM pickup from Nanaimo clinics, same-day delivery to Comox Valley labs. Monthly rates available.
        </p>
      </div>

      <div>
        <h3 class="font-bold mb-2">Can you handle manufacturing equipment to Campbell River mills?</h3>
        <p class="text-gray-700">
          Yes. Industrial parts delivery is common on this route. Oversized/freight available. Earlier cutoff (10 AM) for same-day guarantee due to distance.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
