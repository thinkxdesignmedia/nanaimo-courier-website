---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';

const title = 'About Us | Nanaimo Courier';
const description = 'We know Nanaimo and central Vancouver Island. Fast, reliable, professional same-day courier service.';
---

<BaseLayout {title} {description}>
  <section class="bg-gradient-to-br from-brand-dark via-brand-blue to-brand-dark text-white py-12 md:py-16">
    <div class="section-container">
      <h1 class="text-white mb-4">About {config.businessName}</h1>
      <p class="text-lg md:text-xl opacity-95 max-w-2xl">
        We know every road on Vancouver Island. Nanaimo, ferries, mountain routes, cutoff times. Same-day courier, business logistics, and reliability.
      </p>
    </div>
  </section>

  <section class="section-container">
    <div class="max-w-3xl">
      <h2>Who We Are</h2>

      <p class="text-gray-700 mb-6">
        {config.businessName} is a Nanaimo-based same-day courier service. We specialize in time-critical deliveries across central Vancouver Island—legal documents, medical specimens, rush parts, overnight manufacturing, and everything in between.
      </p>

      <p class="text-gray-700 mb-6">
        We're not a national mega-carrier. We're a local operation that knows Nanaimo streets, courthouse procedures, ferry schedules, and how to move fast when it matters.
      </p>

      <h2>Why Choose Us</h2>

      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div>
          <h3 class="text-brand-blue font-bold mb-3">Local Knowledge</h3>
          <p class="text-gray-700">
            Our drivers live and work in Nanaimo. They know the Malahat, ferry schedules, highway patterns, courthouse security, and hospital access points. Local means faster.
          </p>
        </div>

        <div>
          <h3 class="text-brand-blue font-bold mb-3">Speed When It Matters</h3>
          <p class="text-gray-700">
            Pickup within 30 minutes. Same-day delivery across the island. Rush service available 24/7. We move because your deadline doesn't care about our schedule.
          </p>
        </div>

        <div>
          <h3 class="text-brand-blue font-bold mb-3">Reliability</h3>
          <p class="text-gray-700">
            99%+ on-time delivery. Real-time tracking. Proof of delivery with photo and signature. You know exactly where your shipment is, always.
          </p>
        </div>

        <div>
          <h3 class="text-brand-blue font-bold mb-3">B2B Built</h3>
          <p class="text-gray-700">
            We work with law firms, medical facilities, manufacturing, auto parts, print shops. Volume accounts get flat monthly rates and dedicated service.
          </p>
        </div>
      </div>

      <h2>Our Commitment</h2>

      <p class="text-gray-700 mb-6">
        We treat every shipment as urgent because to our customers, it is. Late delivery for you might mean lost revenue, malpractice risk, or patient care delays. We take that seriously.
      </p>

      <p class="text-gray-700 mb-6">
        No games. No surprise fees. Transparent pricing, real-time tracking, and drivers who know what they're doing.
      </p>

      <h2>Get in Touch</h2>

      <p class="text-gray-700 mb-4">
        Have questions? Call us. Talk to dispatch directly—not a voicemail, not an automated system.
      </p>

      <div class="bg-gray-50 p-6 rounded">
        <p class="text-lg font-bold text-brand-accent mb-2">{config.phone}</p>
        <p class="text-gray-700 mb-4">{config.email}</p>
        <p class="text-sm text-gray-600">
          {config.hours.weekday} weekdays • {config.hours.weekend} weekends
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
