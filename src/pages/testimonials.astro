---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { config } from '../config';

const title = 'Customer Reviews & Testimonials';
const description = 'See why Nanaimo businesses choose our same-day courier — speed, reliability, and photo proof of delivery on every run. Share your experience.';
---

<BaseLayout {title} {description}>
  <PageHero
    word="Reviews"
    eyebrow="Testimonials"
    description="Hear from law firms, medical clinics, and businesses across Vancouver Island who trust us for same-day delivery."
  />

  <section class="section-container">
    <div class="max-w-4xl">
      <div class="mb-12">
        <p class="text-lg text-gray-300 leading-relaxed max-w-2xl">
          {config.businessName} is a Nanaimo-based courier built on reliability — 30-minute pickups, on-time delivery, and photo proof on every run. As we grow our public review base, here's exactly what our service delivers, the industries we support, and how to share your own experience.
        </p>
      </div>

      <div class="mt-12 bg-gray-50 p-8 rounded border border-blue-200">
        <h2 class="text-xl font-bold mb-4">Your review matters</h2>
        <p class="text-gray-700 mb-6">
          Had a great experience with Nanaimo Courier? Leave a review on Google or send us your testimonial.
        </p>
        <a
          href="/contact"
          class="cta-button inline-block"
        >
          Share Your Experience
        </a>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 section-container">
    <h2 class="text-center mb-8">Why Customers Choose Us</h2>

    <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <div class="text-center">
        <div class="text-4xl font-bold text-brand-blue mb-2">3–4 hrs</div>
        <p class="text-gray-700">Nanaimo to Victoria ferry delivery. Reliable timing, every time.</p>
      </div>

      <div class="text-center">
        <div class="text-4xl font-bold text-brand-blue mb-2">45 min</div>
        <p class="text-gray-700">Parksville delivery. Fastest same-day on the island.</p>
      </div>

      <div class="text-center">
        <div class="text-4xl font-bold text-brand-blue mb-2">$18+</div>
        <p class="text-gray-700">Base rate. Transparent pricing, no surprise fees.</p>
      </div>

      <div class="text-center">
        <div class="text-4xl font-bold text-brand-blue mb-2">24/7</div>
        <p class="text-gray-700">Real-time tracking. See your delivery happen live.</p>
      </div>

      <div class="text-center">
        <div class="text-4xl font-bold text-brand-blue mb-2">100%</div>
        <p class="text-gray-700">Proof of delivery. Photo, signature, timestamp on every run.</p>
      </div>

      <div class="text-center">
        <div class="text-4xl font-bold text-brand-blue mb-2">15 min</div>
        <p class="text-gray-700">Response time. Call, get a quote, we're on it.</p>
      </div>
    </div>
  </section>

  <section class="section-container">
    <h2 class="text-center mb-8">Industries We Serve</h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
      <div class="card">
        <h3 class="text-brand-blue font-bold mb-2">Law Firms</h3>
        <p class="text-gray-600 text-sm">Courthouse filings, urgent document delivery. Deadlines never missed.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue font-bold mb-2">Medical Clinics & Labs</h3>
        <p class="text-gray-600 text-sm">Specimen transport, temperature control, chain-of-custody documentation.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue font-bold mb-2">Manufacturing</h3>
        <p class="text-gray-600 text-sm">Equipment parts, urgent supplies. Production lines keep running.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue font-bold mb-2">Retail & Tourism</h3>
        <p class="text-gray-600 text-sm">Marketing materials, event logistics, same-day inventory updates.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue font-bold mb-2">Forestry & Lumber</h3>
        <p class="text-gray-600 text-sm">Mill parts and urgent documents. Reliable same-day courier.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue font-bold mb-2">Pharmacies</h3>
        <p class="text-gray-600 text-sm">Prescription delivery, medication transfer, emergency stock runs.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue font-bold mb-2">Print & Publishing</h3>
        <p class="text-gray-600 text-sm">Proofs, collateral, urgent marketing materials. Fast turnaround guaranteed.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue font-bold mb-2">Automotive</h3>
        <p class="text-gray-600 text-sm">Parts delivery, urgent repairs. Keep shops running smoothly.</p>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 section-container">
    <h2 class="text-center mb-8">Ready to experience fast, reliable delivery?</h2>

    <div class="text-center max-w-2xl mx-auto">
      <p class="text-gray-700 mb-8">
        Get your first quote today. Same-day delivery to Nanaimo, Victoria, Comox Valley, and beyond.
      </p>

      <a
        href="#quote"
        class="cta-button inline-block mr-4"
      >
        Get a Quote
      </a>

      <a
        href="/contact"
        class="cta-button-secondary inline-block"
      >
        Contact Us
      </a>
    </div>
  </section>
</BaseLayout>
