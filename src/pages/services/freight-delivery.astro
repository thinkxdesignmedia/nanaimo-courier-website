---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';
import SchemaMarkup from '../../components/SchemaMarkup.astro';
import { config } from '../../config';

const title = 'Freight & Oversized Delivery | Nanaimo Courier';
const description = 'Same-day freight and oversized item delivery. Furniture, equipment, building materials, pallets. Nanaimo and Vancouver Island.';
---

<BaseLayout {title} {description}>
  <SchemaMarkup type="Service" data={{ serviceName: 'Freight & Oversized Delivery', description }} />

  <section class="bg-gradient-to-br from-brand-dark via-brand-blue to-brand-dark text-white py-12 md:py-16">
    <div class="section-container">
      <h1 class="text-white mb-4">Freight & Oversized Item Delivery</h1>
      <p class="text-lg md:text-xl opacity-95 mb-8 max-w-2xl">
        Too big for a regular van? Furniture, equipment, building materials, pallets. Same-day delivery across Nanaimo and Vancouver Island with proper loading and delivery support.
      </p>
      <PhoneCTA text={`Get Quote: ${config.phone}`} />
    </div>
  </section>

  <section class="section-container">
    <h2>What We Haul</h2>

    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <div class="card">
        <h3 class="text-brand-blue mb-3">Furniture & Office Equipment</h3>
        <p>Desks, chairs, cabinets, filing systems. Professional wrapping and delivery to exact location in building.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue mb-3">Palletized Goods</h3>
        <p>Pallet loads, material handling. Forklift assistance available at pickup and dropoff if needed.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue mb-3">Building Materials</h3>
        <p>Drywall, lumber, roofing, concrete. Proper securing and weather protection included.</p>
      </div>

      <div class="card">
        <h3 class="text-brand-blue mb-3">Industrial Equipment</h3>
        <p>Manufacturing parts, medical devices, lab equipment. Careful handling, securement, and proof of delivery.</p>
      </div>
    </div>
  </section>

  <section class="bg-blue-50 section-container">
    <h2>Freight Services Included</h2>

    <ul class="space-y-3 max-w-3xl text-gray-700">
      <li class="flex gap-3">
        <span class="text-brand-accent font-bold">✓</span>
        <span>Professional loading and securing</span>
      </li>
      <li class="flex gap-3">
        <span class="text-brand-accent font-bold">✓</span>
        <span>Protective padding and weatherproofing</span>
      </li>
      <li class="flex gap-3">
        <span class="text-brand-accent font-bold">✓</span>
        <span>Delivery assistance (unloading, placement)</span>
      </li>
      <li class="flex gap-3">
        <span class="text-brand-accent font-bold">✓</span>
        <span>Forklift or pallet jack available</span>
      </li>
      <li class="flex gap-3">
        <span class="text-brand-accent font-bold">✓</span>
        <span>Proper vehicle for load type and size</span>
      </li>
      <li class="flex gap-3">
        <span class="text-brand-accent font-bold">✓</span>
        <span>Signature and photo documentation</span>
      </li>
    </ul>
  </section>

  <section class="section-container">
    <h2>Freight Pricing</h2>

    <div class="max-w-2xl">
      <p class="text-gray-700 mb-6">
        Freight rates depend on size, weight, and distance. We price by vehicle type and mileage:
      </p>

      <div class="bg-white p-6 rounded border border-gray-300 mb-6 space-y-3">
        <div class="pb-3 border-b">
          <h3 class="font-bold mb-1">Standard Van (up to 1 pallet)</h3>
          <p class="text-gray-700">$35 base + $2.00/km within Nanaimo area</p>
        </div>

        <div class="pb-3 border-b">
          <h3 class="font-bold mb-1">Large Box Truck (1–2 pallets)</h3>
          <p class="text-gray-700">$50 base + $2.50/km</p>
        </div>

        <div class="pb-3 border-b">
          <h3 class="font-bold mb-1">Half Ton or Larger</h3>
          <p class="text-gray-700">$75 base + $3.00/km plus weight surcharge if over 5,000 lbs</p>
        </div>

        <div>
          <h3 class="font-bold mb-1">Island Routes (Victoria, Comox)</h3>
          <p class="text-gray-700">Add 50% to rate + ferry costs if applicable</p>
        </div>
      </div>

      <p class="text-sm text-gray-600 mb-4">
        Oversized items that don't fit standard pricing? Call for a custom quote.
      </p>
    </div>
  </section>

  <QuoteForm />

  <section class="section-container">
    <h2>Freight Delivery FAQ</h2>

    <div class="space-y-6 max-w-3xl">
      <div>
        <h3 class="font-bold mb-2">Do I need to help load the truck?</h3>
        <p class="text-gray-700">
          No. We handle the loading professionally. If it's very heavy or awkward, we bring 2 drivers. Unloading at destination is included too.
        </p>
      </div>

      <div>
        <h3 class="font-bold mb-2">Can you handle custom or fragile items?</h3>
        <p class="text-gray-700">
          Yes. Tell us about the item—artwork, antiques, scientific equipment. We'll use proper materials (moving blankets, specialty crating if needed) and handle with care.
        </p>
      </div>

      <div>
        <h3 class="font-bold mb-2">What if the item doesn't fit through a doorway?</h3>
        <p class="text-gray-700">
          We'll work with you on-site to find the solution—window delivery, disassembly, etc. Some situations need a crane or specialized method; we'll coordinate and quote separately.
        </p>
      </div>

      <div>
        <h3 class="font-bold mb-2">Do you do palletized shipments with tracking?</h3>
        <p class="text-gray-700">
          Yes. Pallet tracking available. We can provide packing lists, weight documentation, and proof of delivery for your inventory system.
        </p>
      </div>

      <div>
        <h3 class="font-bold mb-2">Is there a weight or size limit?</h3>
        <p class="text-gray-700">
          We can handle most freight up to 5 tons. Anything larger or oversized (10+ feet long) needs a specialized vehicle—call for availability and rates.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
