---
import PhoneCTA from './PhoneCTA.astro';
import { config } from '../config';

interface Props {
  word: string;          // giant wordmark (single word, uppercased in CSS)
  eyebrow?: string;      // small label above the email
  description?: string;  // right-column intro copy
  cta?: string;          // CTA button label
  image?: string;        // optional hero photo below the wordmark
  imageAlt?: string;
}

const {
  word,
  eyebrow = 'Nanaimo courier',
  description = '',
  cta = 'Get an instant quote',
  image,
  imageAlt = '',
} = Astro.props;
---

<!-- Giant-wordmark hero — matches the homepage design language -->
<section class="bg-brand-dark overflow-hidden border-b border-white/5">
  <div class="max-w-[1700px] mx-auto px-5 pt-12 md:pt-16 pb-14 md:pb-20">
    <h1
      class="font-display font-bold text-gray-200 uppercase leading-[0.82] tracking-tight whitespace-nowrap"
      style="font-size: clamp(3rem, 21vw, 19rem)"
    >
      {word}
    </h1>

    {image && (
      <div class="mt-6 md:mt-8">
        <img
          src={image}
          alt={imageAlt}
          width="1400"
          height="640"
          loading="eager"
          class="w-full h-[30vh] md:h-[44vh] object-cover rounded-2xl"
        />
      </div>
    )}

    <div class="grid md:grid-cols-3 gap-10 mt-10 md:mt-14">
      <div>
        <div class="flex items-center gap-3 text-sm font-medium uppercase tracking-wide text-white">
          <span class="w-2.5 h-2.5 rounded-full bg-white"></span> Nanaimo, BC
        </div>
      </div>

      <div>
        <p class="text-xs uppercase tracking-widest text-brand-iris mb-2">{eyebrow}</p>
        <a href={`mailto:${config.email}`} class="text-white hover:opacity-80 break-all">{config.email}</a>
      </div>

      <div>
        {description && <p class="text-gray-300 leading-relaxed mb-7">{description}</p>}
        <PhoneCTA text={cta} />
      </div>
    </div>
  </div>
</section>
