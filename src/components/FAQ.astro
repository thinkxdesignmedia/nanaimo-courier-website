---
import SchemaMarkup from './SchemaMarkup.astro';

interface Props {
  title?: string;
  faqs: { q: string; a: string }[];
}

const { title = 'Frequently Asked Questions', faqs } = Astro.props;
---

<section class="section-container">
  <h2>{title}</h2>

  <div class="space-y-6 max-w-3xl">
    {faqs.map((f) => (
      <div>
        <h3 class="font-bold mb-2">{f.q}</h3>
        <p class="text-gray-700">{f.a}</p>
      </div>
    ))}
  </div>
</section>

<SchemaMarkup
  type="FAQPage"
  data={{ faqs: faqs.map((f) => ({ question: f.q, answer: f.a })) }}
/>
