---
interface Props {
  text?: string;
  variant?: 'primary' | 'secondary' | 'outline';
}

const { text = 'Need it there today? Get a quote', variant = 'primary' } = Astro.props;

const styles = {
  primary: 'cta-button',
  secondary: 'cta-button-secondary',
  outline: 'cta-button-outline',
};
---

<a
  href="#quote"
  class={styles[variant]}
>
  {text}
</a>
