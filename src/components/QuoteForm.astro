---
import { config } from '../config';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<section id="quote" class="py-16 md:py-24">
  {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <div class="max-w-2xl mx-auto px-4">
    <h2 class="text-center mb-8">Get an Instant Quote</h2>

    <form id="quote-form" class="space-y-4">
      <div class="grid md:grid-cols-2 gap-4">
        <input
          type="text"
          name="pickup_location"
          placeholder="Pickup Address"
          class="form-input"
          required
        />
        <input
          type="text"
          name="dropoff_location"
          placeholder="Drop-off Address"
          class="form-input"
          required
        />
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        <select name="package_size" class="form-input" required aria-label="Package size">
          <option value="">Select Package Size</option>
          <option value="letter">Letter/Small</option>
          <option value="medium">Medium Box</option>
          <option value="large">Large Box</option>
          <option value="oversized">Oversized Item</option>
        </select>

        <input type="datetime-local" name="needed_by" class="form-input" required aria-label="Needed by (date and time)" />
      </div>

      <input
        type="email"
        name="email"
        placeholder="Your Email"
        class="form-input"
        required
      />

      <input
        type="tel"
        name="phone"
        placeholder="Your Phone"
        class="form-input"
        required
      />

      <textarea
        name="notes"
        placeholder="Any special instructions? (optional)"
        class="form-input h-24"
      ></textarea>

      <!-- Honeypot field (hidden from users) -->
      <input type="hidden" name="website_check" value="" />
      <!-- Submit-timing trap: set to page-load time via JS -->
      <input type="hidden" name="form_ts" id="quote-form-ts" value="" />

      <!-- Cloudflare Turnstile -->
      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>}

      <button
        type="submit"
        class="w-full cta-button"
        id="quote-submit"
      >
        Get Quote Now
      </button>

      <div id="quote-status" class="text-center text-sm"></div>

      <p class="text-center text-sm text-gray-400">
        We'll respond within 15 minutes during business hours.
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('quote-form');
  const statusDiv = document.getElementById('quote-status');
  const submitBtn = document.getElementById('quote-submit');

  // Stamp the form load time for the submit-timing trap
  const tsField = document.getElementById('quote-form-ts');
  if (tsField) tsField.value = String(Date.now());

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Only require Turnstile if the widget is present (it's configured)
      const turnstileEl = document.querySelector('.cf-turnstile');
      if (turnstileEl) {
        const turnstileResponse = document.querySelector('[name="cf-turnstile-response"]');
        if (!turnstileResponse || !turnstileResponse.value) {
          statusDiv.textContent = '❌ Please complete the verification';
          statusDiv.className = 'text-center text-sm text-red-600 mt-2';
          return;
        }
      }

      submitBtn.disabled = true;
      statusDiv.textContent = '⏳ Submitting...';
      statusDiv.className = 'text-center text-sm text-gray-600 mt-2';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch('/api/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          statusDiv.textContent = '✅ Quote request submitted! We\'ll contact you shortly.';
          statusDiv.className = 'text-center text-sm text-green-600 mt-2';
          form.reset();
          // Reset Turnstile
          if (window.turnstile) {
            window.turnstile.reset();
          }
          setTimeout(() => {
            statusDiv.textContent = '';
          }, 5000);
        } else {
          statusDiv.textContent = `❌ ${result.error || 'Error submitting quote. Please call us instead.'}`;
          statusDiv.className = 'text-center text-sm text-red-600 mt-2';
        }
      } catch (error) {
        console.error('Quote submission error:', error);
        statusDiv.textContent = '❌ Error submitting quote. Please call us instead.';
        statusDiv.className = 'text-center text-sm text-red-600 mt-2';
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>
