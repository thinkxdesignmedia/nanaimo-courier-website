---
import { config } from '../config';
---

<header class="sticky top-0 z-50 bg-brand-darker border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 text-white" aria-label={`${config.businessName} home`}>
      <svg class="w-8 h-8 flex-shrink-0" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
        <path d="M16 3.2 L27.5 9.6 L16 16 L4.5 9.6 Z" />
        <path d="M4.5 9.6 L16 16 L16 28.8 L4.5 22.4 Z" />
        <path d="M27.5 9.6 L16 16 L16 28.8 L27.5 22.4 Z" />
        <path d="M10.25 6.4 L21.75 12.8" />
      </svg>
      <span class="text-2xl font-display font-medium tracking-tight lowercase">{config.businessName}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex gap-8 text-sm font-medium">
      <!-- Services Dropdown -->
      <div class="group relative">
        <button class="text-gray-200 hover:text-white py-2">
          Services
        </button>
        <div class="absolute left-0 mt-0 w-48 bg-brand-panel border border-white/10 rounded-xl overflow-hidden shadow-2xl shadow-black/50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          <a href="/services/same-day-delivery" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Same-Day Delivery</a>
          <a href="/services/rush-delivery" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Rush & Hot-Shot</a>
          <a href="/services/medical-courier" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Medical & Lab</a>
          <a href="/services/legal-courier" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Legal Courier</a>
          <a href="/services/walmart-pickup" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Walmart Pickup</a>
          <a href="/services/grocery-pickup" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Grocery Delivery</a>
          <a href="/services/ikea-delivery" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">IKEA Delivery</a>
        </div>
      </div>

      <!-- Routes -->
      <a href="/routes/nanaimo-victoria" class="text-gray-200 hover:text-white py-2">Routes</a>

      <!-- Pages Dropdown -->
      <div class="group relative">
        <button class="text-gray-200 hover:text-white py-2">
          Pages
        </button>
        <div class="absolute left-0 mt-0 w-48 bg-brand-panel border border-white/10 rounded-xl overflow-hidden shadow-2xl shadow-black/50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
          <a href="/about" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">About Us</a>
          <a href="/industries" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Industries</a>
          <a href="/pricing" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Pricing</a>
          <a href="/faq" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">FAQs</a>
          <a href="/testimonials" class="block px-4 py-3 text-gray-300 hover:bg-white/5 hover:text-white">Testimonials</a>
        </div>
      </div>

      <a href="/blog" class="text-gray-200 hover:text-white py-2">Blog</a>
      <a href="/contact" class="text-gray-200 hover:text-white py-2">Contact</a>
    </nav>

    <!-- CTA Button -->
    <div class="flex items-center gap-3">
      <a
        href="#quote"
        class="hidden sm:inline-flex px-6 py-2.5 bg-brand-indigo text-white font-medium rounded-full hover:brightness-110 transition-all text-sm"
      >
        Get Quote
      </a>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden text-gray-200 hover:text-white"
        id="menu-toggle"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-brand-panel border-t border-white/10">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-3">
      <div>
        <button class="w-full text-left py-2 font-medium text-white" id="services-toggle">Services</button>
        <div id="services-submenu" class="hidden pl-4 space-y-2">
          <a href="/services/same-day-delivery" class="block py-2 text-gray-400 hover:text-white">Same-Day Delivery</a>
          <a href="/services/rush-delivery" class="block py-2 text-gray-400 hover:text-white">Rush & Hot-Shot</a>
          <a href="/services/medical-courier" class="block py-2 text-gray-400 hover:text-white">Medical & Lab</a>
          <a href="/services/legal-courier" class="block py-2 text-gray-400 hover:text-white">Legal Courier</a>
          <a href="/services/walmart-pickup" class="block py-2 text-gray-400 hover:text-white">Walmart Pickup</a>
          <a href="/services/grocery-pickup" class="block py-2 text-gray-400 hover:text-white">Grocery Delivery</a>
          <a href="/services/ikea-delivery" class="block py-2 text-gray-400 hover:text-white">IKEA Delivery</a>
        </div>
      </div>
      <a href="/routes/nanaimo-victoria" class="py-2 text-gray-200 hover:text-white">Routes</a>
      <a href="/about" class="py-2 text-gray-200 hover:text-white">About</a>
      <a href="/industries" class="py-2 text-gray-200 hover:text-white">Industries</a>
      <a href="/pricing" class="py-2 text-gray-200 hover:text-white">Pricing</a>
      <a href="/faq" class="py-2 text-gray-200 hover:text-white">FAQs</a>
      <a href="/blog" class="py-2 text-gray-200 hover:text-white">Blog</a>
      <a href="#quote" class="py-2 text-brand-indigo font-medium">Get Quote</a>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const servicesToggle = document.getElementById('services-toggle');
  const servicesSubmenu = document.getElementById('services-submenu');

  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  if (servicesToggle && servicesSubmenu) {
    servicesToggle.addEventListener('click', () => {
      servicesSubmenu.classList.toggle('hidden');
    });
  }
</script>
