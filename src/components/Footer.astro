---
import { config } from '../config';
---

<footer class="bg-gray-900 text-gray-300 mt-16">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-5 gap-8 mb-12">
      <!-- Company Info -->
      <div>
        <h3 class="text-white font-bold mb-4 text-lg">{config.businessName}</h3>
        <p class="text-sm text-gray-400 mb-6">Fast, reliable courier and delivery service for Nanaimo and central Vancouver Island. Same-day service, 24/7 support.</p>

        <div class="space-y-3 text-sm mb-6">
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Email</p>
            <a href={`mailto:${config.email}`} class="text-brand-blue hover:text-white font-semibold">
              {config.email}
            </a>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Hours</p>
            <p class="text-sm text-gray-300"><strong>M–F:</strong> {config.hours.weekday}</p>
            <p class="text-sm text-gray-300"><strong>Sa–Su:</strong> {config.hours.weekend}</p>
          </div>
        </div>

        <div class="flex gap-3">
          <a href="#quote" class="inline-block px-3 py-2 bg-brand-blue text-white text-xs font-bold rounded hover:bg-brand-navy transition">
            Get Quote
          </a>
          <a href="/contact" class="inline-block px-3 py-2 border border-brand-blue text-brand-blue text-xs font-bold rounded hover:bg-brand-blue hover:text-white transition">
            Contact
          </a>
        </div>
      </div>

      <!-- Delivery Services -->
      <div>
        <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wide">Delivery</h4>
        <ul class="text-sm space-y-2">
          <li><a href="/services/same-day-delivery" class="text-gray-400 hover:text-brand-blue transition">Same-Day</a></li>
          <li><a href="/services/rush-delivery" class="text-gray-400 hover:text-brand-blue transition">Rush & Emergency</a></li>
          <li><a href="/services/scheduled-delivery" class="text-gray-400 hover:text-brand-blue transition">Scheduled Routes</a></li>
        </ul>
      </div>

      <!-- Specialized Services -->
      <div>
        <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wide">Specialized</h4>
        <ul class="text-sm space-y-2">
          <li><a href="/services/medical-courier" class="text-gray-400 hover:text-brand-blue transition">Medical & Lab</a></li>
          <li><a href="/services/legal-courier" class="text-gray-400 hover:text-brand-blue transition">Legal Courier</a></li>
        </ul>
      </div>

      <!-- Retail & Routes -->
      <div>
        <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wide">Retail & Routes</h4>
        <ul class="text-sm space-y-2">
          <li><a href="/services/walmart-pickup" class="text-gray-400 hover:text-brand-blue transition">Walmart Pickup</a></li>
          <li><a href="/services/grocery-pickup" class="text-gray-400 hover:text-brand-blue transition">Grocery Delivery</a></li>
          <li><a href="/services/ikea-delivery" class="text-gray-400 hover:text-brand-blue transition">IKEA Delivery</a></li>
          <li><a href="/routes/nanaimo-victoria" class="text-gray-400 hover:text-brand-blue transition">View Routes</a></li>
        </ul>
      </div>
    </div>

    <!-- Resources Section -->
    <div class="border-t border-gray-800 pt-8 mb-8">
      <div class="grid md:grid-cols-5 gap-8">
        <div>
          <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wide">Industries</h4>
          <ul class="text-sm space-y-2">
            <li><a href="/industries" class="text-gray-400 hover:text-brand-blue transition">Legal</a></li>
            <li><a href="/industries" class="text-gray-400 hover:text-brand-blue transition">Medical</a></li>
            <li><a href="/industries" class="text-gray-400 hover:text-brand-blue transition">Manufacturing</a></li>
            <li><a href="/industries" class="text-gray-400 hover:text-brand-blue transition">Retail</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wide">Resources</h4>
          <ul class="text-sm space-y-2">
            <li><a href="/pricing" class="text-gray-400 hover:text-brand-blue transition">Pricing</a></li>
            <li><a href="/faq" class="text-gray-400 hover:text-brand-blue transition">FAQ</a></li>
            <li><a href="/blog" class="text-gray-400 hover:text-brand-blue transition">Blog</a></li>
            <li><a href="/about" class="text-gray-400 hover:text-brand-blue transition">About</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wide">Legal</h4>
          <ul class="text-sm space-y-2">
            <li><a href="/privacy" class="text-gray-400 hover:text-brand-blue transition">Privacy Policy</a></li>
            <li><a href="/terms" class="text-gray-400 hover:text-brand-blue transition">Terms</a></li>
            <li><a href="/sitemap.xml" class="text-gray-400 hover:text-brand-blue transition">Sitemap</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold mb-4 text-sm uppercase tracking-wide">Quick Links</h4>
          <ul class="text-sm space-y-2">
            <li><a href="#quote" class="text-gray-400 hover:text-brand-blue transition">Get Quote</a></li>
            <li><a href="/contact" class="text-gray-400 hover:text-brand-blue transition">Contact Sales</a></li>
            <li><a href="/testimonials" class="text-gray-400 hover:text-brand-blue transition">Testimonials</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Trust Signals -->
    <div class="border-t border-gray-800 pt-8 mb-8">
      <div class="grid md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-bold text-brand-blue mb-2">30 min</div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Average Pickup</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-brand-blue mb-2">100%</div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">On-Time Rate</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-brand-blue mb-2">24/7</div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Emergency Service</p>
        </div>
        <div>
          <div class="text-3xl font-bold text-brand-blue mb-2">4 Islands</div>
          <p class="text-xs text-gray-500 uppercase tracking-wide">Coverage Area</p>
        </div>
      </div>
    </div>

    <!-- Bottom Footer -->
    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-sm">
      <div class="mb-6 md:mb-0">
        <p class="text-xs text-gray-500 mb-2">SERVING VANCOUVER ISLAND</p>
        <p class="text-gray-400 text-xs">Nanaimo • Victoria • Comox Valley • Parksville • Port Alberni • Duncan</p>
        <p class="text-gray-500 text-xs mt-4">&copy; {new Date().getFullYear()} {config.businessName}. All rights reserved.</p>
        <p class="text-xs text-gray-600 mt-2">
          Website by <a href="https://thinkxdesign.com" class="text-brand-blue hover:text-white" target="_blank" rel="noopener noreferrer">Think X Design Media</a>
        </p>
      </div>
    </div>
  </div>
</footer>
